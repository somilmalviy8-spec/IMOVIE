# ==========================================
# The IMovies - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Cloud or local instance):
MONGODB_URI=your_mongodb_connection_string_here

# JWT Authentication (Replace with a strong random secret key)
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
