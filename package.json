{
  "name": "the-imovies-workspace",
  "version": "1.0.0",
  "description": "The IMovies - Modern Cinema Discovery & Ticket Booking Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,yellow\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "make-admin": "node backend/scripts/promoteAdmin.js"
  },
  "keywords": [
    "cinema",
    "movies",
    "ticket-booking",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
